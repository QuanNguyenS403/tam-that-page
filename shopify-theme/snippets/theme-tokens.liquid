@theme {
  --radius-card: 12px;
  --radius-badge: 999px;
  --radius-btn: 8px;

  /* Bảng màu thương hiệu — có thể ghi đè bằng settings ở từng section */
  --color-canvas: {{ settings.color_canvas | default: '#faf7f2' }};
  --color-cream: {{ settings.color_cream | default: '#f2ede3' }};
  --color-dark: {{ settings.color_dark | default: '#1c1a16' }};
  --color-parchment: #f5e6c3;
  --color-pale-fern: #c8ddd4;
  --color-forest: {{ settings.color_forest | default: '#1b3a2d' }};
  --color-jade: #2d6a4f;
  --color-sage: #5c8a72;
  --color-gold: {{ settings.color_gold | default: '#c9983a' }};
  --color-amber: {{ settings.color_amber | default: '#e8b75a' }};
  --color-stone-900: #1c1a16;
  --color-stone-600: #5c5750;
  --color-stone-300: #c4bdb4;
  --color-stone-100: #f0ede8;
  --color-trust-green: #2e7d32;
  --color-alert-amber: #e65100;

  --font-display: "Outfit", system-ui, sans-serif;
  --font-body: "Outfit", system-ui, sans-serif;
  --font-mono: "Outfit", monospace;

  --text-display-xl: clamp(2.5rem, 5vw, 4.5rem);
  --text-display-xl--line-height: 1.1;
  --text-display-xl--letter-spacing: -0.02em;
  --text-display-lg: clamp(2rem, 4vw, 3.5rem);
  --text-display-lg--line-height: 1.15;
  --text-display-md: clamp(1.75rem, 3vw, 2.75rem);
  --text-display-md--line-height: 1.2;
  --text-display-sm: clamp(1.375rem, 2vw, 2rem);
  --text-display-sm--line-height: 1.25;
  --text-body-xl: 1.25rem;
  --text-body-xl--line-height: 1.7;
  --text-body-lg: 1.125rem;
  --text-body-lg--line-height: 1.65;
  --text-body-base: 1rem;
  --text-body-base--line-height: 1.6;
  --text-body-sm: 0.875rem;
  --text-body-sm--line-height: 1.55;
  --text-label-lg: 0.8125rem;
  --text-label-lg--line-height: 1;
  --text-label-lg--letter-spacing: 0.1em;
  --text-label-sm: 0.6875rem;
  --text-label-sm--line-height: 1;
  --text-label-sm--letter-spacing: 0.12em;
  --text-price-xl: clamp(2rem, 4vw, 3rem);

  --spacing-section-sm: 3rem;
  --spacing-section-md: 5rem;

  --container-content: 720px;
  --container-wide: 1100px;

  --shadow-card: 0 2px 12px 0 rgba(27, 58, 45, 0.08);
  --shadow-card-hover: 0 8px 32px 0 rgba(27, 58, 45, 0.16);
  --shadow-gold: 0 4px 20px 0 rgba(201, 152, 58, 0.35);
  --shadow-glass: 0 8px 32px 0 rgba(27, 58, 45, 0.12);

  --blur-glass: 12px;

  --animate-marquee: marquee 22s linear infinite;
  --animate-shimmer: shimmer 2.5s linear infinite;

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
}

[x-cloak] { display: none !important; }
