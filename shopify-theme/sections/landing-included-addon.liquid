{% comment %}
  Landing Included & Addon Section
{% endcomment %}
<section id="quy-cach-dong-goi" aria-label="Quy cách đóng gói và hướng dẫn sử dụng" class="bg-canvas py-section-sm md:py-section-md" style="background-color: var(--canvas); padding: 4rem 0;">
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; align-items: start;">
      
      <!-- Main Tabbed Box -->
      <div class="lg:col-span-2 rounded-card bg-cream border border-stone-300 p-6 md:p-8" style="grid-column: span 2 / span 2; background-color: var(--cream); border: 1px solid var(--stone-300); border-radius: 12px; padding: 2rem;">
        <div role="tablist" class="flex gap-4 border-b border-stone-300 mb-6" style="display: flex; gap: 1rem; border-bottom: 1px solid var(--stone-300); margin-bottom: 1.5rem;">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-addon-tab="panel-1"
            class="pb-3 font-body text-body-base font-semibold border-b-2 border-forest text-forest"
            style="padding-bottom: 0.75rem; font-size: 1rem; font-weight: 600; border-bottom: 2px solid var(--forest); color: var(--forest); background: none; border-top: none; border-left: none; border-right: none; cursor: pointer;"
          >
            Bộ Sản Phẩm Bao Gồm
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-addon-tab="panel-2"
            class="pb-3 font-body text-body-base font-semibold border-b-2 border-transparent text-stone-600 hover:text-stone-900"
            style="padding-bottom: 0.75rem; font-size: 1rem; font-weight: 600; border-bottom: 2px solid transparent; color: var(--stone-600); background: none; border-top: none; border-left: none; border-right: none; cursor: pointer;"
          >
            Hướng Dẫn Sử Dụng
          </button>
        </div>

        <!-- Panel 1: Included Items -->
        <div role="tabpanel" data-addon-panel="panel-1" class="space-y-4" style="display: flex; flex-direction: column; gap: 1rem;">
          <h3 class="font-display text-display-sm text-forest font-bold" style="color: var(--forest); font-size: 1.5rem; font-weight: 700; margin: 0;">
            {{ section.settings.included_title | default: "Gói Tam Thất Bắc Nguyên Chất 100g / 300g / 500g" }}
          </h3>
          <ul class="space-y-3" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
            {% for block in section.blocks %}
              {% if block.type == 'included_item' %}
                <li class="flex gap-3 items-start" style="display: flex; gap: 0.75rem; align-items: flex-start;" {{ block.shopify_attributes }}>
                  <span style="color: var(--trust-green); font-weight: bold;">✓</span>
                  <span class="font-body text-body-base text-stone-900" style="color: var(--stone-900); font-size: 1rem;">{{ block.settings.text }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>

        <!-- Panel 2: How to Use Guide -->
        <div role="tabpanel" data-addon-panel="panel-2" class="space-y-4 hidden" style="display: flex; flex-direction: column; gap: 1rem;">
          <h3 class="font-display text-display-sm text-forest font-bold" style="color: var(--forest); font-size: 1.5rem; font-weight: 700; margin: 0;">
            Cách pha uống mỗi ngày đơn giản:
          </h3>
          <ol class="space-y-3" style="padding-left: 1.25rem; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
            {% for block in section.blocks %}
              {% if block.type == 'usage_step' %}
                <li class="font-body text-body-base text-stone-900" style="color: var(--stone-900); font-size: 1rem;" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </li>
              {% endif %}
            {% endfor %}
          </ol>
          {% if section.settings.usage_image != blank %}
            <div class="rounded-card overflow-hidden bg-pale-fern mt-2" style="border-radius: 12px; overflow: hidden; background-color: var(--pale-fern); margin-top: 0.5rem;">
              <img src="{{ section.settings.usage_image | image_url: width: 800 }}" alt="Hướng dẫn pha Tam Thất" width="800" height="450" class="w-full h-auto object-cover" style="width: 100%; height: auto; object-fit: cover;" loading="lazy">
            </div>
          {% endif %}
          <p class="mt-4 font-body text-body-sm italic text-stone-600" style="color: var(--stone-600); font-style: italic; font-size: 0.875rem;">Đơn giản. Đều đặn. Chuẩn bị chưa tới 2 phút mỗi ngày.</p>
        </div>
      </div>

      <!-- Aside Gift Box Addon -->
      <aside class="rounded-card bg-pale-fern/50 border border-sage/40 p-6 md:p-8 flex flex-col gap-4" style="background-color: rgba(200, 221, 212, 0.5); border: 1px solid rgba(92, 138, 114, 0.4); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <div class="rounded-card overflow-hidden aspect-[4/3] bg-canvas" style="border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; background-color: var(--canvas);">
          {% if section.settings.gift_box_image != blank %}
            <img src="{{ section.settings.gift_box_image | image_url: width: 600 }}" alt="Hộp quà biếu" width="600" height="450" class="w-full h-full object-cover" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
          {% else %}
            {{ 'product-2' | placeholder_svg_tag: 'w-full h-full object-cover' }}
          {% endif %}
        </div>
        <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-forest" style="color: var(--forest); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin: 0;">
          Dịch Vụ Đi Kèm
        </p>
        <h3 class="font-display text-display-sm text-forest font-bold" style="color: var(--forest); font-size: 1.375rem; font-weight: 700; margin: 0;">
          {{ section.settings.gift_box_title | default: "Tùy Chọn Hộp Quà Biếu Cao Cấp" }}
        </h3>
        <p class="font-body text-body-sm text-stone-600 leading-relaxed" style="color: var(--stone-600); font-size: 0.875rem; line-height: 1.55; margin: 0;">
          {{ section.settings.gift_box_body | default: "Thêm nơ gấm thủ công và thiệp viết tay cá nhân hóa. Biến đơn hàng của bạn thành món quà trang trọng chuẩn bị chu đáo." }}
        </p>
        <a href="#san-pham" class="bg-forest text-amber font-body font-bold text-label-lg uppercase tracking-widest py-3 px-4 rounded-btn text-center hover:bg-jade transition-colors" style="background-color: var(--forest); color: var(--amber); font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; text-align: center; padding: 0.75rem 1rem; border-radius: 8px; text-decoration: none;">
          Miễn Phí Cho Đơn Từ 2 Sản Phẩm
        </a>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Included & Addon",
  "settings": [
    {
      "type": "text",
      "id": "included_title",
      "label": "Included Package Title",
      "default": "Gói Tam Thất Bắc Nguyên Chất 100g / 300g / 500g"
    },
    {
      "type": "image_picker",
      "id": "usage_image",
      "label": "How to Use Guide Image"
    },
    {
      "type": "text",
      "id": "gift_box_title",
      "label": "Gift Box Addon Title",
      "default": "Tùy Chọn Hộp Quà Biếu Cao Cấp"
    },
    {
      "type": "textarea",
      "id": "gift_box_body",
      "label": "Gift Box Description",
      "default": "Thêm nơ gấm thủ công và thiệp viết tay cá nhân hóa."
    },
    {
      "type": "image_picker",
      "id": "gift_box_image",
      "label": "Gift Box Image"
    }
  ],
  "blocks": [
    {
      "type": "included_item",
      "name": "Included Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item Description",
          "default": "1 × Túi Tam Thất Bắc Hà Giang xay mịn nguyên chất"
        }
      ]
    },
    {
      "type": "usage_step",
      "name": "Usage Step",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Step Text",
          "default": "Lấy 3–5g bột Tam Thất (khoảng 1 thìa cà phê nhỏ) vào cốc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Included & Addon",
      "blocks": [
        { "type": "included_item", "settings": { "text": "1 × Túi Tam Thất Bắc Hà Giang xay mịn nguyên chất" } },
        { "type": "included_item", "settings": { "text": "Bao bì chống ẩm cao cấp chuẩn bảo quản dược liệu" } },
        { "type": "included_item", "settings": { "text": "Hộp đựng thiết kế tối giản làm quà biếu" } },
        { "type": "included_item", "settings": { "text": "Thẻ hướng dẫn liều lượng và cách dùng chuẩn y học cổ truyền" } },
        { "type": "included_item", "settings": { "text": "Nguyên liệu Tam thất Bắc tuyển chọn từ Hà Giang" } },
        { "type": "usage_step", "settings": { "text": "Lấy 3–5g bột Tam Thất (khoảng 1 thìa cà phê nhỏ) vào cốc" } },
        { "type": "usage_step", "settings": { "text": "Rót 100–150ml nước ấm (khoảng 60–70°C), khuấy đều cho tan hoàn toàn" } },
        { "type": "usage_step", "settings": { "text": "Uống vào buổi sáng trước bữa ăn 30 phút hoặc buổi tối trước khi đi ngủ" } },
        { "type": "usage_step", "settings": { "text": "Có thể kết hợp cùng mật ong nguyên chất để tăng hương vị và công dụng" } }
      ]
    }
  ]
}
{% endschema %}
