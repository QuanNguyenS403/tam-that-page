        },
        {
          "type": "text",
          "id": "link_2_text",
          "label": "Link 2 Text",
          "default": "Gói Gia Đình 300g"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "link_3_text",
          "label": "Link 3 Text",
          "default": "Gói Tích Lũy 500g"
        },
        {
          "type": "url",
          "id": "link_3_url",
