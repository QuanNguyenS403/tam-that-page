    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact Email",
      "default": "ducquan16102006@gmail.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Contact Phone",
      "default": "0981 753 082"
    },
    {
