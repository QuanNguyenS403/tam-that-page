{% comment %}
  Landing Footer Section
{% endcomment %}
<footer id="footer" aria-label="Chân trang" class="bg-dark text-stone-300 border-t border-stone-600" style="background-color: var(--dark); color: var(--stone-300); border-top: 1px solid var(--stone-600);">
  <div class="max-w-wide mx-auto px-4 sm:px-8 py-section-sm md:py-section-md" style="max-width: 1100px; margin: 0 auto; padding: 4rem 2rem;">
    <!-- Top Footer Header & Newsletter Signup -->
    <div class="mb-12 pb-8 border-b border-stone-600 flex flex-col md:flex-row justify-between items-start md:items-center gap-6" style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--stone-600); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem;">
      <div>
        <h3 class="font-display text-display-sm text-amber font-bold mb-2" style="color: var(--amber); font-weight: 700; font-size: 1.5rem; margin: 0 0 0.5rem 0;">
          {{ section.settings.brand_title | default: "QuanNguyenS" }}
        </h3>
        <p class="font-body text-body-base text-stone-300 max-w-xl" style="color: var(--stone-300); font-size: 1rem; max-width: 576px; margin: 0;">
          {{ section.settings.brand_description | default: "Tam Thất Bắc được tuyển chọn từ vùng nguyên liệu Hà Giang, chế biến và đóng gói theo tiêu chuẩn của Tam Thất Quân Nguyễn." }}
        </p>
      </div>

      {% form 'customer', class: 'flex gap-2 w-full md:w-auto' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="footer-email-{{ section.id }}" class="sr-only">Email nhận ưu đãi</label>
        <input
          id="footer-email-{{ section.id }}"
          type="email"
          name="contact[email]"
          required
          placeholder="Nhập email của bạn"
          class="px-4 py-2.5 rounded-btn bg-stone-900 border border-stone-600 text-stone-100 placeholder:text-stone-300 text-body-sm outline-none"
          style="padding: 0.625rem 1rem; border-radius: 8px; background-color: var(--stone-900); border: 1px solid var(--stone-600); color: var(--stone-100); font-size: 0.875rem;"
        >
        <button type="submit" class="bg-gold hover:bg-amber text-dark font-body font-bold text-label-lg uppercase tracking-widest px-5 py-2.5 rounded-btn transition-colors shrink-0" style="background-color: var(--gold); color: var(--dark); font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; padding: 0.625rem 1.25rem; border-radius: 8px; border: none; cursor: pointer;">
          Đăng Ký
        </button>
      {% endform %}
    </div>

    <!-- Navigation Link Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <h4 class="font-body text-label-lg font-bold text-amber uppercase tracking-wider mb-4" style="color: var(--amber); font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; margin: 0 0 1rem 0;">
            {{ block.settings.heading }}
          </h4>
          <ul class="space-y-2.5" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.625rem;">
            {% if block.settings.link_1_text != blank %}
              <li><a href="{{ block.settings.link_1_url }}" class="font-body text-body-sm text-stone-300 hover:text-gold" style="color: var(--stone-300); font-size: 0.875rem; text-decoration: none;">{{ block.settings.link_1_text }}</a></li>
            {% endif %}
            {% if block.settings.link_2_text != blank %}
              <li><a href="{{ block.settings.link_2_url }}" class="font-body text-body-sm text-stone-300 hover:text-gold" style="color: var(--stone-300); font-size: 0.875rem; text-decoration: none;">{{ block.settings.link_2_text }}</a></li>
            {% endif %}
            {% if block.settings.link_3_text != blank %}
              <li><a href="{{ block.settings.link_3_url }}" class="font-body text-body-sm text-stone-300 hover:text-gold" style="color: var(--stone-300); font-size: 0.875rem; text-decoration: none;">{{ block.settings.link_3_text }}</a></li>
            {% endif %}
            {% if block.settings.link_4_text != blank %}
              <li><a href="{{ block.settings.link_4_url }}" class="font-body text-body-sm text-stone-300 hover:text-gold" style="color: var(--stone-300); font-size: 0.875rem; text-decoration: none;">{{ block.settings.link_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endfor %}
    </div>

    <!-- Contact & Brand Slogan Row -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 py-8 border-t border-stone-600 font-body text-body-sm" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; padding: 2rem 0; border-top: 1px solid var(--stone-600); font-size: 0.875rem;">
      <div class="space-y-3" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <p style="margin: 0;">✉ {{ section.settings.email | default: "ducquan16102006@gmail.com" }}</p>
        <p style="margin: 0;">📞 {{ section.settings.phone | default: "0981 753 082" }}</p>
        <p style="margin: 0;">📍 {{ section.settings.address | default: "Amber Riverside, 622 Minh Khai, Vĩnh Tuy, Hai Bà Trưng, Hà Nội" }}</p>
        <p style="margin: 0;">⏰ {{ section.settings.hours | default: "Thứ Hai – Chủ Nhật: 7:00 – 22:00" }}</p>
      </div>
      <div class="flex flex-col justify-end items-start md:items-end gap-2 text-stone-300" style="display: flex; flex-direction: column; justify-content: flex-end; gap: 0.5rem; color: var(--stone-300);">
        <p class="font-semibold text-amber" style="color: var(--amber); font-weight: 600; margin: 0;">"BÁN SỰ MINH BẠCH, CHẤT LƯỢNG VÀ NIỀM TIN."</p>
        <p style="margin: 0;">© 2026 Tam Thất Quân Nguyễn. Bảo lưu mọi quyền.</p>
      </div>
    </div>

    <!-- Medical Disclaimer -->
    <div class="pt-6 border-t border-stone-600 text-label-sm text-stone-300" style="padding-top: 1.5rem; border-top: 1px solid var(--stone-600); font-size: 0.6875rem; color: var(--stone-300);">
      <p class="leading-relaxed" style="margin: 0; line-height: 1.5;">
        * Khuyến cáo: Sản phẩm Tam Thất Quân Nguyễn là dược liệu truyền thống bồi bổ sức khỏe, không phải là thuốc và không có tác dụng thay thế thuốc chữa bệnh.
      </p>
    </div>
  </div>
</footer>

{% schema %}
