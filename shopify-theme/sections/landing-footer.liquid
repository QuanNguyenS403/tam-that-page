        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4 URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "Sản Phẩm",
            "link_1_text": "Gói Dùng Thử 100g", "link_1_url": "#san-pham",
            "link_2_text": "Gói Gia Đình 300g", "link_2_url": "#san-pham",
            "link_3_text": "Gói Tích Lũy 500g", "link_3_url": "#san-pham",
            "link_4_text": "Hộp Quà Biếu Tặng", "link_4_url": "#san-pham"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Tìm Hiểu",
            "link_1_text": "Công Dụng Tam Thất", "link_1_url": "#cong-dung",
            "link_2_text": "Hướng Dẫn Sử Dụng", "link_2_url": "#cach-dung",
            "link_3_text": "Quy Trình Thu Hoạch", "link_3_url": "#quy-trinh-san-xuat",
            "link_4_text": "Nguồn Gốc Hà Giang", "link_4_url": "#tinh-xac-thuc"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Thương Hiệu",
            "link_1_text": "Giá Trị Thương Hiệu", "link_1_url": "#gia-tri-thuong-hieu",
