{% comment %}
  Landing Guarantee Block Section
{% endcomment %}
<section id="cam-ket" aria-label="Cam kết chất lượng và chính sách hoàn tiền" class="bg-canvas py-section-sm md:py-section-md" style="background-color: var(--canvas); padding: 4rem 0;">
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="rounded-card bg-forest text-stone-100 p-8 md:p-14 shadow-glass" style="border-radius: 12px; background-color: var(--forest); color: var(--stone-100); padding: 3rem;">
      <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-amber mb-3" style="color: var(--amber); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.75rem;">
        {{ section.settings.eyebrow | default: "CAM KẾT TỪ QUANNGUYENS" }}
      </p>
      <h2 class="font-display text-display-md text-amber mb-6 leading-[1.2]" style="color: var(--amber); font-size: 2.25rem; line-height: 1.2; margin-bottom: 1.5rem;">
        {{ section.settings.title | default: "✓ Tam thất Bắc nguyên chất · Tuyển chọn kỹ · Đóng gói cẩn thận · Đổi trả 30 ngày" }}
      </h2>
      <div class="max-w-content space-y-4 font-body text-body-lg text-stone-300 leading-relaxed mb-10" style="max-width: 720px; display: flex; flex-direction: column; gap: 1rem; color: var(--stone-300); font-size: 1.125rem; margin-bottom: 2.5rem;">
        <p style="margin: 0;">{{ section.settings.p1 | default: "Chúng tôi xây dựng thương hiệu Tam Thất Quân Nguyễn trên một lời hứa: Mỗi hộp sản phẩm đến tay bạn phải đạt chuẩn mực cao nhất về nguồn gốc, độ tinh khiết và trải nghiệm đóng gói." }}</p>
        <p style="margin: 0;">{{ section.settings.p2 | default: "Nếu sản phẩm gặp sự cố trong quá trình vận chuyển hoặc không đạt chất lượng cam kết, vui lòng liên hệ trong vòng 30 ngày. Chúng tôi sẽ đổi trả hoặc hoàn tiền 100% ngay lập tức — không thủ tục rườm rà." }}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-6 border-t border-jade/50 font-body text-body-sm" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; border-top: 1px solid rgba(45, 106, 79, 0.5); padding-top: 1.5rem; font-size: 0.875rem;">
        {% for block in section.blocks %}
          <div class="flex items-center gap-3" style="display: flex; align-items: center; gap: 0.75rem;" {{ block.shopify_attributes }}>
            <span style="color: var(--gold); font-size: 1.25rem;">{{ block.settings.icon }}</span>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Guarantee Block",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CAM KẾT TỪ QUANNGUYENS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "✓ Tam thất Bắc nguyên chất · Tuyển chọn kỹ · Đóng gói cẩn thận · Đổi trả 30 ngày"
    },
    {
      "type": "textarea",
      "id": "p1",
      "label": "Paragraph 1",
      "default": "Chúng tôi xây dựng thương hiệu Tam Thất Quân Nguyễn trên một lời hứa..."
    },
    {
      "type": "textarea",
      "id": "p2",
      "label": "Paragraph 2",
      "default": "Nếu sản phẩm gặp sự cố trong quá trình vận chuyển hoặc không đạt chất lượng cam kết..."
    }
  ],
  "blocks": [
    {
      "type": "promise_badge",
      "name": "Promise Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Thanh toán an toàn bảo mật"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Guarantee Block",
      "blocks": [
        { "type": "promise_badge", "settings": { "icon": "🛡️", "text": "Thanh toán an toàn bảo mật" } },
        { "type": "promise_badge", "settings": { "icon": "🚚", "text": "Giao hàng nhanh có mã vận đơn" } },
        { "type": "promise_badge", "settings": { "icon": "🔄", "text": "Đổi trả 30 ngày không lý do" } },
        { "type": "promise_badge", "settings": { "icon": "🏆", "text": "Chuẩn kiểm nghiệm QUATEST 3" } }
      ]
    }
  ]
}
{% endschema %}
