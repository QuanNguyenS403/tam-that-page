{% comment %}
  Landing Header / Navbar Section
{% endcomment %}
<header class="sticky top-0 z-50 bg-canvas/95 backdrop-blur-glass shadow-sm border-b border-stone-300" style="position: sticky; top: 0; z-index: 50; background-color: rgba(250, 247, 242, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--stone-300);">
  <nav class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 xl:px-16 flex items-center justify-between h-16 md:h-20" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem; height: 5rem; display: flex; align-items: center; justify-content: space-between;" aria-label="Điều hướng chính">
    <a href="{{ routes.root_url }}" class="font-display text-display-sm text-forest font-bold" style="text-decoration: none; color: var(--forest); font-size: 1.5rem; font-weight: 700;">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="150" height="40" style="height: auto; max-height: 45px;">
      {% else %}
        {{ section.settings.brand_text | default: shop.name }}
      {% endif %}
    </a>

    <ul class="hidden lg:flex items-center gap-8" style="display: flex; align-items: center; gap: 2rem; list-style: none; margin: 0; padding: 0;">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <a
            href="{{ block.settings.url }}"
            class="font-body text-body-sm font-medium text-stone-900 hover:text-forest transition-colors duration-200 uppercase tracking-wide"
            style="text-decoration: none; color: var(--stone-900); font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em;"
          >
            {{ block.settings.title }}
          </a>
        </li>
      {% endfor %}
    </ul>

    <div class="flex items-center gap-4" style="display: flex; align-items: center; gap: 1rem;">
      <a
        href="{{ section.settings.cta_url | default: '#san-pham' }}"
        class="hidden sm:inline-block bg-forest text-amber font-body font-semibold text-label-lg uppercase tracking-widest px-5 py-2.5 rounded-btn hover:bg-jade transition-colors duration-200 shadow-sm"
        style="background-color: var(--forest); color: var(--amber); font-weight: 600; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.625rem 1.25rem; border-radius: 8px; text-decoration: none;"
      >
        {{ section.settings.cta_text | default: "Đặt Mua Ngay" }}
      </a>
      <button aria-label="Mở menu" class="lg:hidden text-stone-900" data-mobile-nav-toggle style="background: none; border: none; cursor: pointer; padding: 0.5rem; color: var(--stone-900);">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <div class="lg:hidden hidden border-t border-stone-300 bg-canvas" data-mobile-menu style="border-top: 1px solid var(--stone-300); background-color: var(--canvas); padding: 1rem 1.5rem;">
    <ul class="px-4 py-4 flex flex-col gap-3" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem;">
      {% for block in section.blocks %}
        <li>
          <a
            href="{{ block.settings.url }}"
            class="block py-2 font-body text-body-base font-medium text-stone-900 uppercase tracking-wide"
            style="text-decoration: none; color: var(--stone-900); font-weight: 500; text-transform: uppercase;"
          >
            {{ block.settings.title }}
          </a>
        </li>
      {% endfor %}
      <li style="padding-top: 0.5rem;">
        <a
          href="{{ section.settings.cta_url | default: '#san-pham' }}"
          class="block text-center bg-forest text-amber font-body font-semibold text-label-lg uppercase tracking-widest px-5 py-3 rounded-btn"
          style="display: block; text-align: center; background-color: var(--forest); color: var(--amber); padding: 0.75rem 1.25rem; border-radius: 8px; text-decoration: none; font-weight: 600;"
        >
          {{ section.settings.cta_text | default: "Đặt Mua Ngay" }}
        </a>
      </li>
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "Landing Navbar",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Title",
      "default": "QuanNguyenS"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Đặt Mua Ngay"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Link Text",
          "default": "Công Dụng"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Navbar",
      "blocks": [
        { "type": "nav_link", "settings": { "title": "Công Dụng", "url": "#cong-dung" } },
        { "type": "nav_link", "settings": { "title": "Cách Dùng", "url": "#cach-dung" } },
        { "type": "nav_link", "settings": { "title": "Đánh Giá", "url": "#danh-gia" } },
        { "type": "nav_link", "settings": { "title": "Bảng So Sánh", "url": "#bang-so-sanh" } },
        { "type": "nav_link", "settings": { "title": "Hỏi & Đáp", "url": "#faq" } }
      ]
    }
  ]
}
{% endschema %}
