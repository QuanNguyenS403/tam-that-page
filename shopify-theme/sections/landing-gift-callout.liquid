{% comment %}
  Landing Gift Callout Section
{% endcomment %}
<section
  id="qua-tang"
  aria-label="Ý nghĩa quà tặng"
  class="bg-dark text-stone-100 py-section-sm md:py-section-md overflow-hidden"
  style="background-color: var(--dark); color: var(--stone-100); padding: 4rem 0; overflow: hidden;"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
      <div>
        <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.75rem;">
          {{ section.settings.eyebrow | default: "Món Quà Ý Nghĩa" }}
        </p>
        <h2 class="font-display text-display-md text-amber mb-6 leading-[1.2]" style="color: var(--amber); font-size: 2.25rem; line-height: 1.2; margin-bottom: 1.5rem;">
          {{ section.settings.title | default: "Món quà dành cho những người bạn quan tâm" }}
        </h2>
        <div class="space-y-4 font-body text-body-lg text-stone-300 leading-relaxed" style="display: flex; flex-direction: column; gap: 1rem; color: var(--stone-300); font-size: 1.125rem; line-height: 1.65;">
          <p style="margin: 0;">Rượu rồi sẽ cạn. Bánh ngọt thưởng thức một lần rồi qua. Giỏ quà trang trí thường bị xếp vào một góc.</p>
          <p style="margin: 0;">Tam Thất Quân Nguyễn thì khác. Đó là món quà gửi gắm thông điệp cá nhân sâu sắc — bạn chọn sức khỏe thay vì thói quen, chọn chất lượng thay vì sự tiện lợi.</p>
          <p style="margin: 0;">Dù là mừng thọ cha mẹ, quà biếu Tết, mừng nghỉ hưu hay lời cảm ơn đối tác quan trọng — đây là món quà phản ánh sự tinh tế của người tặng.</p>
          <p class="font-semibold text-amber" style="color: var(--amber); font-weight: 600; margin: 0;">
            {{ section.settings.highlight_text | default: "Bởi vì món quà tuyệt vời nhất không phải là đắt nhất, mà là tâm huyết nhất." }}
          </p>
        </div>
        <a
          href="{{ section.settings.cta_url | default: '#san-pham' }}"
          class="inline-block mt-8 bg-gold hover:bg-amber text-dark font-body font-bold text-label-lg uppercase tracking-widest px-6 py-3.5 rounded-btn transition-colors duration-200 shadow-gold"
          style="display: inline-block; margin-top: 2rem; background-color: var(--gold); color: var(--dark); font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.875rem 1.5rem; border-radius: 8px; text-decoration: none;"
        >
          {{ section.settings.cta_text | default: "Chọn Quà Ngay →" }}
        </a>
      </div>

      <div class="aspect-square rounded-card overflow-hidden bg-forest/40 border border-stone-600" style="aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; background-color: rgba(27, 58, 45, 0.4); border: 1px solid var(--stone-600);">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.title | escape }}"
            class="w-full h-full object-cover"
            style="width: 100%; height: 100%; object-fit: cover;"
            loading="lazy"
          >
        {% else %}
          {{ 'product-3' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Gift Callout",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Món Quà Ý Nghĩa"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Món quà dành cho những người bạn quan tâm"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlighted Text",
      "default": "Bởi vì món quà tuyệt vời nhất không phải là đắt nhất, mà là tâm huyết nhất."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Chọn Quà Ngay →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Gift Image"
    }
  ],
  "presets": [
    {
      "name": "Landing Gift Callout"
    }
  ]
}
{% endschema %}
