{% comment %}
  Landing FAQ Section
{% endcomment %}
<section id="faq" aria-label="Câu hỏi thường gặp" class="bg-canvas py-section-sm md:py-section-md" style="background-color: var(--canvas); padding: 4rem 0;">
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="text-center max-w-content mx-auto mb-10 md:mb-14" style="text-align: center; max-width: 720px; margin: 0 auto 3rem auto;">
      <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.75rem;">
        {{ section.settings.eyebrow | default: "Giải Đáp Thắc Mắc" }}
      </p>
      <h2 class="font-display text-display-md text-forest leading-[1.2] mb-4" style="color: var(--forest); font-size: 2.25rem; line-height: 1.2; margin-bottom: 1rem;">
        {{ section.settings.title | default: "Những câu hỏi thường gặp về Tam Thất Quân Nguyễn" }}
      </h2>
      <p class="font-body text-body-lg text-stone-600" style="color: var(--stone-600); font-size: 1.125rem; margin: 0;">
        {{ section.settings.subtitle | default: "Mọi điều bạn cần biết trước khi đặt mua sản phẩm." }}
      </p>
    </div>

    <div class="max-w-content mx-auto space-y-4" style="max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem;">
      {% for block in section.blocks %}
        <div
          data-faq-item
          class="bg-cream border border-stone-300 rounded-card overflow-hidden transition-colors"
          style="background-color: var(--cream); border: 1px solid var(--stone-300); border-radius: 12px; overflow: hidden;"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            data-faq-button
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
            class="w-full flex items-center justify-between gap-4 p-5 md:p-6 text-left group"
            style="width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.5rem; text-align: left; background: none; border: none; cursor: pointer;"
          >
            <span class="font-body text-body-lg font-bold text-stone-900" style="font-size: 1.125rem; font-weight: 700; color: var(--stone-900);">
              {{ block.settings.question }}
            </span>
            <span data-faq-icon class="transition-transform duration-200 {% if forloop.first %}rotate-180{% endif %}" style="display: inline-block; transition: transform 0.2s ease;">
              ▼
            </span>
          </button>

          <div
            data-faq-content
            class="px-5 pb-5 md:px-6 md:pb-6 font-body text-body-base text-stone-600 leading-relaxed border-t border-stone-300/60 pt-4 {% unless forloop.first %}hidden{% endunless %}"
            style="padding: 1rem 1.5rem 1.5rem 1.5rem; font-size: 1rem; color: var(--stone-600); line-height: 1.6; border-top: 1px solid rgba(196, 189, 180, 0.6);"
          >
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Giải Đáp Thắc Mắc"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Những câu hỏi thường gặp về Tam Thất Quân Nguyễn"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Mọi điều bạn cần biết trước khi đặt mua sản phẩm."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Tam Thất Bắc Quân Nguyễn có nguồn gốc từ đâu?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Tam Thất Quân Nguyễn được thu hái trực tiếp tại các vùng núi đá cao 1.400m–1.800m thuộc Bắc Hà Giang."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "Tam Thất Bắc Quân Nguyễn có nguồn gốc từ đâu?", "answer": "Tam Thất Quân Nguyễn được thu hái trực tiếp tại các vùng núi đá cao 1.400m–1.800m thuộc Bắc Hà Giang (Đồng Văn, Mèo Vạc, Hoàng Su Phì). Cây được trồng tự nhiên đủ 7 năm tuổi trở lên trước khi thu hoạch." } },
        { "type": "faq_item", "settings": { "question": "Làm thế nào để truy xuất nguồn gốc sản phẩm?", "answer": "Mỗi hộp sản phẩm đều được dán tem chống hàng giả tích hợp mã QR. Bạn chỉ cần dùng camera điện thoại hoặc Zalo quét mã QR để xem ngay vị trí vườn trồng, thông tin lô thu hoạch." } },
        { "type": "faq_item", "settings": { "question": "Cách pha và thời điểm uống Tam Thất tốt nhất là khi nào?", "answer": "Bạn dùng 3–5g bột Tam Thất (khoảng 1 thìa cà phê) hòa với 100–150ml nước ấm. Uống vào buổi sáng trước khi ăn 30 phút hoặc buổi tối trước khi đi ngủ." } },
        { "type": "faq_item", "settings": { "question": "Chính sách đổi trả và hoàn tiền áp dụng ra sao?", "answer": "Chúng tôi cam kết hoàn tiền 100% trong vòng 30 ngày nếu bạn phát hiện hàng giả, hàng kém chất lượng hoặc không hài lòng với sản phẩm." } }
      ]
    }
  ]
}
{% endschema %}
