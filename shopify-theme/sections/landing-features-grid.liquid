{% comment %}
  Landing Features Grid Section
{% endcomment %}
<section
  id="cong-dung"
  aria-label="Đặc điểm nổi bật"
  class="bg-canvas py-section-sm md:py-section-md"
  style="background-color: var(--canvas); padding: 4rem 0;"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="text-center mb-10 md:mb-14" style="text-align: center; margin-bottom: 3rem;">
      <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.75rem;">
        {{ section.settings.eyebrow | default: "Tại Sao Khác Biệt" }}
      </p>
      <h2 class="font-display text-display-md text-forest max-w-content mx-auto leading-[1.2]" style="color: var(--forest); font-size: 2.25rem; max-width: 720px; margin: 0 auto;">
        {{ section.settings.title | default: "Sáu lý do khiến Tam Thất Quân Nguyễn không thể so sánh với hàng chợ" }}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
      {% for block in section.blocks %}
        <div
          class="group bg-cream border border-stone-300 rounded-card p-6 hover:shadow-card-hover transition-all duration-300"
          style="background-color: var(--cream); border: 1px solid var(--stone-300); border-radius: 12px; padding: 1.5rem;"
          {{ block.shopify_attributes }}
        >
          <span class="text-3xl mb-4 block" role="img" aria-hidden="true" style="font-size: 2rem; margin-bottom: 1rem; display: block;">{{ block.settings.icon }}</span>
          <p class="font-body text-label-sm font-bold uppercase tracking-widest text-sage mb-1.5" style="color: var(--sage); font-weight: 700; font-size: 0.6875rem; text-transform: uppercase; margin-bottom: 0.375rem;">
            {{ block.settings.label }}
          </p>
          <h3 class="font-body text-body-base font-bold text-stone-900 mb-2 leading-snug" style="color: var(--stone-900); font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; line-height: 1.375;">
            {{ block.settings.title }}
          </h3>
          <p class="font-body text-body-sm text-stone-600 leading-relaxed" style="color: var(--stone-600); font-size: 0.875rem; line-height: 1.55; margin: 0;">
            {{ block.settings.body }}
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Features Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Tại Sao Khác Biệt"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Sáu lý do khiến Tam Thất Quân Nguyễn không thể so sánh với hàng chợ"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "💊"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label Tag",
          "default": "NGUYÊN LIỆU TUYỂN CHỌN"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Hàm Lượng Hoạt Chất Cao"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Feature Description",
          "default": "Chỉ sử dụng Tam thất Bắc được lựa chọn theo tiêu chuẩn của thương hiệu."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Features Grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "💊", "label": "NGUYÊN LIỆU TUYỂN CHỌN", "title": "Hàm Lượng Hoạt Chất Cao", "body": "Chỉ sử dụng Tam thất Bắc được lựa chọn theo tiêu chuẩn của thương hiệu." } },
        { "type": "feature", "settings": { "icon": "🚫", "label": "KHÔNG PHA TRỘN", "title": "100% Tam thất Bắc xay mịn", "body": "Không phụ gia, không chất tạo màu, không lưu huỳnh. Phơi tự nhiên và sấy lạnh bảo toàn dưỡng chất tối đa." } },
        { "type": "feature", "settings": { "icon": "🏔️", "label": "SƠ CHẾ CẨN THẬN", "title": "Sơ chế giữ trọn hương vị", "body": "Người Mông Hà Giang phơi Tam Thất trên giàn tre trong gió núi 45–60 ngày." } },
        { "type": "feature", "settings": { "icon": "🌿", "label": "TUYỂN CHỌN NGUYÊN LIỆU", "title": "Chọn lọc trước khi xay", "body": "Nguyên liệu được lựa chọn từ vùng nguyên liệu Hà Giang và kiểm tra trước khi đưa vào chế biến." } },
        { "type": "feature", "settings": { "icon": "🌱", "label": "NGHIỀN THEO TỪNG MẺ", "title": "Giúp sản phẩm luôn mới", "body": "Tam Thất phải 7 năm mới đủ Saponin để thu hoạch. Không có quy trình thúc tăng trưởng nào thay thế được thời gian." } },
        { "type": "feature", "settings": { "icon": "♻️", "label": "ĐÓNG GÓI KÍN", "title": "Bảo quản tối ưu", "body": "Túi kraft tái chế, hộp carton FSC, túi hút chân không kéo dài thời gian bảo quản 18 tháng." } }
      ]
    }
  ]
}
{% endschema %}
