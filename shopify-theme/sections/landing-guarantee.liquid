<section
  id="cam-ket"
  aria-label="Cam kết chất lượng và chính sách hoàn tiền"
  class="bg-canvas py-section-sm md:py-section-md"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8">
    <div class="rounded-card bg-forest text-stone-100 p-8 md:p-14 shadow-glass">
      <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-amber mb-3">{{ section.settings.eyebrow }}</p>
      <h2 class="font-display text-display-md text-amber mb-6 leading-[1.2]">{{ section.settings.heading }}</h2>

      <div class="max-w-content space-y-4 font-body text-body-lg text-stone-300 leading-relaxed mb-10">
        {{ section.settings.body }}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-6 border-t border-jade/50 font-body text-body-sm">
        {%- for block in section.blocks -%}
          <div class="flex items-center gap-3" {{ block.shopify_attributes }}>
            <span class="text-gold text-xl shrink-0" role="img" aria-hidden="true">{{ block.settings.icon }}</span>
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cam kết chất lượng",
  "tag": "section",
  "class": "landing-guarantee-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Màu nền", "default": "#faf7f2" },
    { "type": "text", "id": "eyebrow", "label": "Chữ dẫn", "default": "CAM KẾT TỪ QUANNGUYENS" },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "✓ Tam thất Bắc nguyên chất  ✓ Tuyển chọn kỹ nguyên liệu  ✓ Đóng gói cẩn thận  ✓ Hỗ trợ đổi trả theo chính sách" },
    { "type": "richtext", "id": "body", "label": "Nội dung", "default": "<p>Chúng tôi xây dựng thương hiệu Tam Thất Quân Nguyễn trên một lời hứa: Mỗi hộp sản phẩm đến tay bạn phải đạt chuẩn mực cao nhất về nguồn gốc, độ tinh khiết và trải nghiệm đóng gói.</p><p>Nếu sản phẩm gặp sự cố trong quá trình vận chuyển hoặc không đạt chất lượng cam kết, vui lòng liên hệ trong vòng 30 ngày.</p>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Cam kết",
      "settings": [
        { "type": "text", "id": "icon", "label": "Biểu tượng", "default": "🛡️" },
        { "type": "text", "id": "text", "label": "Nội dung", "default": "Thanh toán an toàn bảo mật" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Cam kết chất lượng",
      "blocks": [
        { "type": "item", "settings": { "icon": "🛡️", "text": "Thanh toán an toàn bảo mật" } },
        { "type": "item", "settings": { "icon": "🚚", "text": "Giao hàng nhanh có mã vận đơn" } },
        { "type": "item", "settings": { "icon": "🔄", "text": "Đổi trả 30 ngày không lý do" } },
        { "type": "item", "settings": { "icon": "🏅", "text": "Chuẩn kiểm nghiệm QUATEST 3" } }
      ]
    }
  ]
}
{% endschema %}
