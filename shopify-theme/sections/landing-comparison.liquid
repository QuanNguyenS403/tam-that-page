{%- assign best = section.settings.best_column -%}
<section
  id="bang-so-sanh"
  aria-label="Bảng so sánh các gói sản phẩm"
  class="bg-cream py-section-sm md:py-section-md"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8">
    <div class="text-center mb-8 md:mb-12 opacity-0 translate-y-6" data-reveal>
      <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3">{{ section.settings.eyebrow }}</p>
      <h2 class="font-display text-display-md text-forest max-w-content mx-auto leading-[1.2]">{{ section.settings.heading }}</h2>
    </div>

    <div class="relative">
      <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[560px] border-separate border-spacing-0 rounded-card overflow-hidden shadow-card">
          <thead>
            <tr class="bg-forest">
              <th class="text-left font-body text-label-lg font-semibold uppercase tracking-wide text-sage py-4 px-5 w-[36%]">{{ section.settings.criteria_label }}</th>
              {%- for i in (1..3) -%}
                {%- assign header_key = 'column_' | append: i | append: '_title' -%}
                {%- assign header = section.settings[header_key] -%}
                {%- if header != blank -%}
                  <th class="font-body text-label-lg font-bold uppercase tracking-wide py-4 px-4 text-center {% if i == best %}text-amber{% else %}text-stone-300{% endif %}">
                    <div class="flex flex-col items-center justify-center h-full">
                      {%- if i == best and section.settings.best_badge != blank -%}
                        <span class="bg-gold text-dark text-label-sm font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-b-badge whitespace-nowrap mb-1">{{ section.settings.best_badge }}</span>
                      {%- endif -%}
                      <span class="block">{{ header }}</span>
                    </div>
                  </th>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr class="{% cycle 'bg-canvas', 'bg-cream' %} hover:bg-pale-fern transition-colors duration-150" {{ block.shopify_attributes }}>
                <td class="font-body text-body-sm font-semibold text-stone-900 py-3.5 px-5 border-b border-stone-300">{{ block.settings.label }}</td>
                {%- for i in (1..3) -%}
                  {%- assign value_key = 'value_' | append: i -%}
                  <td class="font-mono text-body-sm text-center py-3.5 px-4 border-b border-stone-300 {% if i == best %}text-forest font-bold bg-pale-fern/60{% else %}text-stone-600{% endif %}">
                    {{ block.settings[value_key] | default: '—' }}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
          <tfoot>
            <tr class="bg-pale-fern">
              <td class="py-4 px-5 font-body text-body-sm font-semibold text-forest">{{ section.settings.cta_row_label }}</td>
              {%- for i in (1..3) -%}
                <td class="py-4 px-4 text-center">
                  <a
                    href="{{ section.settings.cta_link | default: '#san-pham' }}"
                    class="inline-block font-body text-label-lg font-bold uppercase tracking-wide px-4 py-2.5 rounded-btn transition-all duration-200 w-full {% if i == best %}bg-forest text-amber hover:bg-jade shadow-gold{% else %}border-2 border-forest text-forest hover:bg-pale-fern{% endif %}"
                  >{{ section.settings.cta_label }}</a>
                </td>
              {%- endfor -%}
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="sm:hidden text-center font-body text-label-sm text-stone-600 mt-2">← Vuốt ngang để xem đầy đủ →</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bảng so sánh",
  "tag": "section",
  "class": "landing-comparison-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Màu nền", "default": "#f2ede3" },
    { "type": "text", "id": "eyebrow", "label": "Chữ dẫn", "default": "So Sánh Các Gói" },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Chọn đúng lượng cho nhu cầu của bạn" },
    { "type": "text", "id": "criteria_label", "label": "Nhãn cột tiêu chí", "default": "Tiêu Chí" },
    { "type": "text", "id": "column_1_title", "label": "Cột 1", "default": "Gói Dùng Thử 100g" },
    { "type": "text", "id": "column_2_title", "label": "Cột 2", "default": "Gói Gia Đình 300g" },
    { "type": "text", "id": "column_3_title", "label": "Cột 3", "default": "Gói Tích Lũy 500g" },
    { "type": "range", "id": "best_column", "label": "Cột nổi bật", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "text", "id": "best_badge", "label": "Nhãn nổi bật", "default": "Tiết Kiệm Nhất" },
    { "type": "text", "id": "cta_row_label", "label": "Nhãn hàng CTA", "default": "Đặt Ngay" },
    { "type": "text", "id": "cta_label", "label": "Nhãn nút", "default": "Chọn Gói" },
    { "type": "url", "id": "cta_link", "label": "Liên kết nút" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Hàng so sánh",
      "settings": [
        { "type": "text", "id": "label", "label": "Tiêu chí", "default": "Giá" },
        { "type": "text", "id": "value_1", "label": "Giá trị cột 1", "default": "—" },
        { "type": "text", "id": "value_2", "label": "Giá trị cột 2", "default": "—" },
        { "type": "text", "id": "value_3", "label": "Giá trị cột 3", "default": "—" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Bảng so sánh",
      "blocks": [
        { "type": "row", "settings": { "label": "Giá", "value_1": "299.000 ₫", "value_2": "750.000 ₫", "value_3": "1.150.000 ₫" } },
        { "type": "row", "settings": { "label": "Trọng lượng", "value_1": "100g", "value_2": "300g", "value_3": "500g" } },
        { "type": "row", "settings": { "label": "Tiết kiệm", "value_1": "—", "value_2": "17%", "value_3": "23%" } },
        { "type": "row", "settings": { "label": "Phù hợp cho", "value_1": "Dùng thử lần đầu", "value_2": "1–2 người / tháng", "value_3": "Cả gia đình" } },
        { "type": "row", "settings": { "label": "Thời gian sử dụng", "value_1": "2–3 tuần", "value_2": "2–3 tháng", "value_3": "4–5 tháng" } },
        { "type": "row", "settings": { "label": "Giao hàng miễn phí", "value_1": "—", "value_2": "✓", "value_3": "✓" } },
        { "type": "row", "settings": { "label": "Hộp quà cao cấp", "value_1": "—", "value_2": "—", "value_3": "✓" } }
      ]
    }
  ]
}
{% endschema %}
