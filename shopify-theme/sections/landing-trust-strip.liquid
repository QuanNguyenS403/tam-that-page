<section
  id="trust-strip"
  aria-label="Cam kết chất lượng"
  class="bg-cream border-y border-stone-300 py-4 overflow-x-auto"
  style="--section-bg: {{ section.settings.bg_color }}; background-color: var(--section-bg);"
>
  <div class="flex items-center justify-start sm:justify-center gap-0 min-w-max sm:min-w-0 px-4 sm:px-8 snap-x snap-mandatory">
    {%- for block in section.blocks -%}
      <div class="flex flex-col sm:flex-row items-center gap-1.5 sm:gap-2.5 px-5 sm:px-6 snap-start border-r border-stone-300 last:border-r-0 opacity-0 translate-y-6" data-reveal {{ block.shopify_attributes }}>
        <span class="text-2xl sm:text-xl" role="img" aria-hidden="true">{{ block.settings.icon }}</span>
        <div class="text-center sm:text-left">
          <p class="font-body text-label-lg font-bold uppercase tracking-wide text-forest whitespace-nowrap">{{ block.settings.label }}</p>
          <p class="font-body text-label-sm text-stone-600 whitespace-nowrap">{{ block.settings.sub }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
  <p class="sm:hidden text-center font-body text-label-sm text-stone-600 mt-2 pb-1">← Vuốt ngang để xem thêm →</p>
</section>

{% schema %}
{
  "name": "Dải cam kết",
  "class": "landing-trust-strip-section",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Màu nền", "default": "#f2ede3" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Cam kết",
      "settings": [
        { "type": "text", "id": "icon", "label": "Biểu tượng (emoji)", "default": "🛡️" },
        { "type": "text", "id": "label", "label": "Tiêu đề", "default": "Hoàn Tiền 100%" },
        { "type": "text", "id": "sub", "label": "Mô tả ngắn", "default": "Trong 30 ngày" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Dải cam kết",
      "blocks": [
        { "type": "item", "settings": { "icon": "🛡️", "label": "Hoàn Tiền 100%", "sub": "Trong 30 ngày" } },
        { "type": "item", "settings": { "icon": "📍", "label": "Xuất Xứ Bắc Hà Giang", "sub": "Lựa chọn kĩ lưỡng" } },
        { "type": "item", "settings": { "icon": "🔬", "label": "Kiểm Nghiệm ISO", "sub": "QUATEST 3" } },
        { "type": "item", "settings": { "icon": "🚚", "label": "Giao Toàn Quốc", "sub": "2–3 ngày làm việc" } },
        { "type": "item", "settings": { "icon": "🌿", "label": "Không Phụ Gia", "sub": "100% Nguyên Chất" } }
      ]
    }
  ]
}
{% endschema %}
