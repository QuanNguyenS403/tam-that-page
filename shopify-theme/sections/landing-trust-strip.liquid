{% comment %}
  Landing Trust Strip Section
{% endcomment %}
<section
  id="trust-strip"
  aria-label="Cam kết chất lượng"
  class="bg-cream border-y border-stone-300 py-4 overflow-x-auto"
  style="background-color: var(--cream); border-top: 1px solid var(--stone-300); border-bottom: 1px solid var(--stone-300); padding: 1rem 0; overflow-x: auto;"
>
  <div class="flex items-center justify-start sm:justify-center gap-0 min-w-max sm:min-w-0 px-4 sm:px-8" style="display: flex; align-items: center; justify-content: center; padding: 0 2rem;">
    {% for block in section.blocks %}
      <div
        class="flex flex-col sm:flex-row items-center gap-1.5 sm:gap-2.5 px-5 sm:px-6 border-r border-stone-300 last:border-r-0"
        style="display: flex; align-items: center; gap: 0.625rem; padding: 0 1.5rem; border-right: {% if forloop.last %}none{% else %}1px solid var(--stone-300){% endif %};"
        {{ block.shopify_attributes }}
      >
        <span class="text-2xl sm:text-xl" role="img" aria-hidden="true" style="font-size: 1.5rem;">{{ block.settings.icon }}</span>
        <div class="text-center sm:text-left">
          <p class="font-body text-label-lg font-bold uppercase tracking-wide text-forest whitespace-nowrap" style="color: var(--forest); font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; margin: 0; white-space: nowrap;">
            {{ block.settings.label }}
          </p>
          <p class="font-body text-label-sm text-stone-600 whitespace-nowrap" style="color: var(--stone-600); font-size: 0.6875rem; margin: 0; white-space: nowrap;">
            {{ block.settings.sub }}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Landing Trust Strip",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Hoàn Tiền 100%"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtitle",
          "default": "Trong 30 ngày"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Trust Strip",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "🛡️", "label": "Hoàn Tiền 100%", "sub": "Trong 30 ngày" } },
        { "type": "trust_item", "settings": { "icon": "📍", "label": "Xuất Xứ Bắc Hà Giang", "sub": "Có truy xuất QR" } },
        { "type": "trust_item", "settings": { "icon": "🔬", "label": "Kiểm Nghiệm ISO", "sub": "QUATEST 3" } },
        { "type": "trust_item", "settings": { "icon": "🚚", "label": "Giao Toàn Quốc", "sub": "2–3 ngày làm việc" } },
        { "type": "trust_item", "settings": { "icon": "🌿", "label": "Không Phụ Gia", "sub": "100% Nguyên Chất" } }
      ]
    }
  ]
}
{% endschema %}
