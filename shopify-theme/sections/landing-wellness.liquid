<section
  id="cach-dung"
  aria-label="Thói quen chăm sóc sức khỏe hàng ngày"
  class="bg-cream py-section-sm md:py-section-md"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="aspect-square rounded-card overflow-hidden bg-pale-fern shadow-card opacity-0 translate-y-6" data-reveal>
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            class="w-full h-full object-cover"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        {%- endif -%}
      </div>

      <div>
        <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3">{{ section.settings.eyebrow }}</p>
        <h2 class="font-display text-display-md text-forest leading-[1.2] mb-6">{{ section.settings.heading }}</h2>

        <div class="space-y-4 font-body text-body-lg text-stone-600 leading-relaxed mb-8">
          {%- for block in section.blocks -%}
            {%- if block.type == 'paragraph' -%}
              <p class="{% if block.settings.highlight %}font-semibold text-forest{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <ul class="space-y-3 mb-8">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}
              <li class="flex gap-3 items-start" {{ block.shopify_attributes }}>
                <span class="text-trust-green shrink-0 mt-0.5" aria-hidden="true">✓</span>
                <span class="font-body text-body-base text-stone-900">{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if section.settings.footnote != blank -%}
          <p class="font-body text-body-sm italic text-stone-600">{{ section.settings.footnote }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Thói quen mỗi ngày",
  "tag": "section",
  "class": "landing-wellness-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Màu nền", "default": "#f2ede3" },
    { "type": "image_picker", "id": "image", "label": "Hình ảnh" },
    { "type": "text", "id": "eyebrow", "label": "Chữ dẫn", "default": "Thói Quen Mỗi Ngày" },
    { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Thói quen dưỡng sinh đơn giản nhất bạn có thể duy trì mỗi ngày" },
    { "type": "text", "id": "footnote", "label": "Ghi chú cuối", "default": "Dược liệu cổ truyền — Phong cách sống hiện đại." }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Đoạn văn",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Nội dung", "default": "Nội dung đoạn văn." },
        { "type": "checkbox", "id": "highlight", "label": "Làm nổi bật", "default": false }
      ]
    },
    {
      "type": "bullet",
      "name": "Gạch đầu dòng",
      "settings": [
        { "type": "text", "id": "text", "label": "Nội dung", "default": "Lợi ích sản phẩm" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thói quen mỗi ngày",
      "blocks": [
        { "type": "paragraph", "settings": { "text": "Hầu hết các phương pháp dưỡng sinh đều thất bại vì quá phức tạp, mất nhiều thời gian hoặc tốn kém." } },
        { "type": "paragraph", "settings": { "text": "Tam Thất Quân Nguyễn được thiết kế theo một nguyên tắc: sản phẩm dược liệu tốt nhất phải dễ dàng hòa nhập vào nhịp sống của bạn." } },
        { "type": "paragraph", "settings": { "text": "Một thìa bột. Nước ấm. Hai phút mỗi sáng.", "highlight": true } },
        { "type": "paragraph", "settings": { "text": "Chỉ đơn giản như vậy. Và vì chuẩn bị nhanh chóng, thói quen tốt này sẽ đồng hành cùng bạn mỗi ngày." } },
        { "type": "bullet", "settings": { "text": "Không cần đun sắc hay chế biến phức tạp" } },
        { "type": "bullet", "settings": { "text": "Bột mịn hòa tan nhanh, mùi thơm tự nhiên" } },
        { "type": "bullet", "settings": { "text": "Bao bì khóa zip chống ẩm tiện mang đi làm hoặc du lịch" } },
        { "type": "bullet", "settings": { "text": "Hướng dẫn liều lượng rõ ràng trên từng bao bì" } },
        { "type": "bullet", "settings": { "text": "Hạn sử dụng 18 tháng bảo quản dễ dàng" } }
      ]
    }
  ]
}
{% endschema %}
