{% comment %}
  Landing Heritage Banner Section
{% endcomment %}
<section
  id="gia-tri-thuong-hieu"
  aria-label="Giá trị thương hiệu"
  class="bg-dark py-section-sm md:py-section-md overflow-hidden"
  style="background-color: var(--dark); padding: 4rem 0; overflow: hidden;"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8 text-center" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem; text-align: center;">
    <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-4" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;">
      {{ section.settings.eyebrow | default: "GIÁ TRỊ CỦA TAM THẤT BẮT ĐẦU TỪ VÙNG NGUYÊN LIỆU" }}
    </p>

    <blockquote class="font-display text-display-md text-amber leading-[1.3] max-w-content mx-auto mb-6" style="color: var(--amber); font-size: 2rem; line-height: 1.3; max-width: 720px; margin: 0 auto 1.5rem auto; border: none; padding: 0;">
      "{{ section.settings.quote | default: "Chúng tôi lựa chọn nguồn Tam thất từ vùng núi cao Hà Giang, nơi có khí hậu mát mẻ quanh năm và điều kiện tự nhiên phù hợp để cây phát triển ổn định. Mỗi lô nguyên liệu đều được tuyển chọn và kiểm tra trước khi đưa vào chế biến." }}"
    </blockquote>

    <cite class="not-italic font-body text-body-sm text-stone-300 block mb-12" style="font-style: normal; color: var(--stone-300); font-size: 0.875rem; display: block; margin-bottom: 3rem;">
      — {{ section.settings.author | default: "Ông Vàng Mí Chứ, người trồng Tam Thất, Đồng Văn, Hà Giang" }}
    </cite>

    {% if section.settings.image != blank %}
      <div class="rounded-card overflow-hidden mb-12 max-w-4xl mx-auto bg-forest/40" style="border-radius: 12px; overflow: hidden; margin-bottom: 3rem; max-width: 896px; margin-left: auto; margin-right: auto;">
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.quote | escape }}" class="w-full h-auto object-cover" style="width: 100%; height: auto; object-fit: cover;" loading="lazy">
      </div>
    {% endif %}

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 border-t border-stone-600 pt-10" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; border-top: 1px solid var(--stone-600); padding-top: 2.5rem;">
      {% for block in section.blocks %}
        <div class="flex flex-col items-center gap-1" style="display: flex; flex-direction: column; align-items: center; gap: 0.25rem;" {{ block.shopify_attributes }}>
          <span class="font-mono text-display-md text-gold font-bold" style="font-family: monospace; font-size: 2.25rem; font-weight: 700; color: var(--gold);">
            {{ block.settings.value }}
          </span>
          <span class="font-body text-label-lg uppercase tracking-wide text-stone-300" style="color: var(--stone-300); font-size: 0.8125rem; text-transform: uppercase;">
            {{ block.settings.label }}
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Heritage Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "GIÁ TRỊ CỦA TAM THẤT BẮT ĐẦU TỪ VÙNG NGUYÊN LIỆU"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "Chúng tôi lựa chọn nguồn Tam thất từ vùng núi cao Hà Giang, nơi có khí hậu mát mẻ quanh năm và điều kiện tự nhiên phù hợp để cây phát triển ổn định."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author Citation",
      "default": "Ông Vàng Mí Chứ, người trồng Tam Thất, Đồng Văn, Hà Giang"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Heritage Banner Image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Stat Value",
          "default": "10.000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Khách hàng tin dùng"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Heritage Banner",
      "blocks": [
        { "type": "stat", "settings": { "value": "10.000+", "label": "Khách hàng tin dùng" } },
        { "type": "stat", "settings": { "value": "7 năm", "label": "Tuổi cây tối thiểu" } },
        { "type": "stat", "settings": { "value": "5.000+", "label": "Đơn hàng thành công" } },
        { "type": "stat", "settings": { "value": "30 ngày", "label": "Cam kết hoàn tiền" } }
      ]
    }
  ]
}
{% endschema %}
