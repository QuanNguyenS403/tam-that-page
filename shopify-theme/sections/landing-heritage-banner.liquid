<section
  id="gia-tri-thuong-hieu"
  aria-label="Giá trị thương hiệu"
  class="bg-dark py-section-sm md:py-section-md overflow-hidden"
  style="--section-bg: {{ section.settings.bg_color }}; background-color: var(--section-bg);"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8 text-center">
    <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-4">{{ section.settings.eyebrow }}</p>

    <blockquote class="font-display text-display-md text-amber leading-[1.3] max-w-content mx-auto mb-6 opacity-0 translate-y-6" data-reveal>
      {{ section.settings.quote }}
    </blockquote>

    {%- if section.settings.image != blank -%}
      <div class="rounded-card overflow-hidden mb-12 max-w-4xl mx-auto bg-forest/40">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'w-full h-auto object-cover', alt: section.settings.image_alt }}
      </div>
    {%- endif -%}

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 border-t border-stone-600 pt-10">
      {%- for block in section.blocks -%}
        <div class="flex flex-col items-center gap-1" {{ block.shopify_attributes }}>
          <count-up class="font-mono text-display-md text-gold font-bold" data-value="{{ block.settings.value }}" data-suffix="{{ block.settings.suffix }}">0{{ block.settings.suffix }}</count-up>
          <span class="font-body text-label-lg uppercase tracking-wide text-stone-300">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Giá trị thương hiệu",
  "class": "landing-heritage-section",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Màu nền", "default": "#1c1a16" },
    { "type": "text", "id": "eyebrow", "label": "Chữ dẫn", "default": "GIÁ TRỊ CỦA TAM THẤT BẮT ĐẦU TỪ VÙNG NGUYÊN LIỆU" },
    { "type": "richtext", "id": "quote", "label": "Trích dẫn", "default": "<p>Chúng tôi lựa chọn nguồn Tam thất từ vùng núi cao Hà Giang, nơi có khí hậu mát mẻ quanh năm và điều kiện tự nhiên phù hợp để cây phát triển ổn định. Mỗi lô nguyên liệu đều được tuyển chọn và kiểm tra trước khi đưa vào chế biến.</p>" },
    { "type": "image_picker", "id": "image", "label": "Ảnh minh họa" },
    { "type": "text", "id": "image_alt", "label": "Mô tả ảnh", "default": "Lợi ích sức khỏe của Tam Thất Bắc nguyên chất" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Số liệu",
      "settings": [
        { "type": "range", "id": "value", "label": "Giá trị", "min": 0, "max": 20000, "step": 100, "default": 10000 },
        { "type": "text", "id": "suffix", "label": "Hậu tố", "default": "+" },
        { "type": "text", "id": "label", "label": "Nhãn", "default": "Khách hàng tin dùng" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Giá trị thương hiệu",
      "blocks": [
        { "type": "stat", "settings": { "value": 10000, "suffix": "+", "label": "Khách hàng tin dùng" } },
        { "type": "stat", "settings": { "value": 7, "suffix": " năm", "label": "Tuổi cây tối thiểu" } },
        { "type": "stat", "settings": { "value": 5000, "suffix": "+", "label": "Đơn hàng thành công" } },
        { "type": "stat", "settings": { "value": 30, "suffix": " ngày", "label": "Cam kết hoàn tiền" } }
      ]
    }
  ]
}
{% endschema %}
