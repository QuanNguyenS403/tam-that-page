{% comment %}
  Landing Video Module Section
{% endcomment %}
<section
  id="quy-trinh-san-xuat"
  aria-label="Video quy trình sản xuất"
  class="bg-cream py-section-sm md:py-section-md"
  data-video-module
  style="background-color: var(--cream); padding: 4rem 0;"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    {% if section.settings.eyebrow != blank %}
      <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3 text-center" style="color: var(--sage); text-align: center; text-transform: uppercase; font-size: 0.8125rem;">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="font-display text-display-md text-forest text-center max-w-content mx-auto leading-[1.2] mb-10" style="color: var(--forest); text-align: center; max-width: 720px; margin: 0 auto 2.5rem auto; font-size: 2.25rem;">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="relative w-full max-w-wide mx-auto rounded-card overflow-hidden aspect-video bg-dark shadow-glass" style="position: relative; width: 100%; max-width: 1100px; margin: 0 auto; border-radius: 12px; overflow: hidden; aspect-ratio: 16 / 9; background-color: var(--dark);">
      <video
        src="{{ section.settings.video_url | default: "7809966088298.mp4" | asset_url }}"
        {% if section.settings.poster_image != blank %}
          poster="{{ section.settings.poster_image | image_url: width: 1200 }}"
        {% endif %}
        class="w-full h-full object-cover"
        style="width: 100%; height: 100%; object-fit: cover;"
        playsinline
        preload="metadata"
      ></video>

      <div data-video-overlay class="absolute inset-0 bg-dark/30 backdrop-blur-[2px] pointer-events-none" style="position: absolute; inset: 0; background-color: rgba(28, 26, 22, 0.3); pointer-events: none;"></div>
      
      <div class="absolute inset-0 flex items-center justify-center" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
        <button
          type="button"
          data-play-button
          class="bg-amber/90 hover:bg-amber text-dark w-16 h-16 rounded-full flex items-center justify-center shadow-gold transition-all duration-200"
          style="background-color: var(--amber); color: var(--dark); width: 4rem; height: 4rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; box-shadow: 0 4px 20px 0 rgba(201,152,58,0.35);"
          aria-label="Phát video quy trình sản xuất"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </button>
      </div>
    </div>

    {% if section.settings.caption != blank %}
      <p class="text-center font-body text-body-sm text-stone-600 mt-3" style="text-align: center; color: var(--stone-600); font-size: 0.875rem; margin-top: 0.75rem;">
        {{ section.settings.caption }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Landing Video Module",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Quy Trình Sản Xuất"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Hành trình từ vườn trồng đến hũ Tam thất nguyên chất"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Custom Video Filename or URL",
      "info": "Filename of video in assets/ folder, e.g., 7809966088298.mp4"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Video Poster Cover Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption Text",
      "default": "Video thực tế quy trình phơi sấy và nghiền bột Tam thất Bắc"
    }
  ],
  "presets": [
    {
      "name": "Landing Video Module"
    }
  ]
}
{% endschema %}
