{% comment %}
  Landing Authenticity Callout Section
{% endcomment %}
<section
  id="tinh-xac-thuc"
  aria-label="Bằng chứng chất lượng"
  class="bg-canvas py-section-sm md:py-section-md"
  style="background-color: var(--canvas); padding: 4rem 0;"
>
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
      <div>
        <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.75rem;">
          {{ section.settings.eyebrow | default: "Chứng Minh Không Bằng Lời Nói" }}
        </p>
        <h2 class="font-display text-display-md text-forest mb-5 leading-[1.2]" style="color: var(--forest); font-size: 2.25rem; line-height: 1.2; margin-bottom: 1.25rem;">
          {{ section.settings.title | default: "Điều gì giúp bạn nhận biết một sản phẩm Tam thất đáng tin cậy?" }}
        </h2>
        <p class="font-body text-body-lg text-stone-600 mb-8 max-w-content leading-relaxed" style="color: var(--stone-600); font-size: 1.125rem; line-height: 1.65; margin-bottom: 2rem;">
          {{ section.settings.subtitle | default: "Tam thất Bắc được tuyển chọn từ vùng nguyên liệu Hà Giang, kiểm tra và đóng gói cẩn thận trước khi đến tay bạn." }}
        </p>

        <div class="flex flex-col gap-5" style="display: flex; flex-direction: column; gap: 1.25rem;">
          {% for block in section.blocks %}
            <div class="flex gap-4 items-start" style="display: flex; gap: 1rem; align-items: flex-start;" {{ block.shopify_attributes }}>
              <span class="text-2xl mt-0.5 flex-shrink-0" role="img" aria-hidden="true" style="font-size: 1.5rem;">{{ block.settings.icon }}</span>
              <div>
                <h3 class="font-body text-body-base font-bold text-stone-900 mb-1" style="color: var(--stone-900); font-weight: 700; font-size: 1rem; margin: 0 0 0.25rem 0;">
                  {{ block.settings.title }}
                </h3>
                <p class="font-body text-body-sm text-stone-600 leading-relaxed" style="color: var(--stone-600); font-size: 0.875rem; margin: 0;">
                  {{ block.settings.body }}
                </p>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.link_text != blank %}
          <a
            href="{{ section.settings.link_url | default: '#tinh-xac-thuc' }}"
            class="inline-flex items-center gap-2 mt-8 text-forest font-body font-semibold text-body-sm border-b-2 border-gold hover:border-forest transition-colors duration-200 pb-0.5"
            style="color: var(--forest); font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--gold); display: inline-flex; margin-top: 2rem;"
          >
            {{ section.settings.link_text }} →
          </a>
        {% endif %}
      </div>

      <div class="relative rounded-card overflow-hidden aspect-[4/3] bg-pale-fern" style="border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; background-color: var(--pale-fern);">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.title | escape }}"
            width="800"
            height="600"
            class="w-full h-full object-cover"
            style="width: 100%; height: 100%; object-fit: cover;"
            loading="lazy"
          >
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Authenticity",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Chứng Minh Không Bằng Lời Nói"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Điều gì giúp bạn nhận biết một sản phẩm Tam thất đáng tin cậy?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tam thất Bắc được tuyển chọn từ vùng nguyên liệu Hà Giang, kiểm tra và đóng gói cẩn thận trước khi đến tay bạn."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Tìm hiểu quy trình tuyển chọn nguyên liệu"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Authenticity Image"
    }
  ],
  "blocks": [
    {
      "type": "proof_point",
      "name": "Proof Point",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nguyên liệu tuyển chọn"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Description",
          "default": "Tam thất Bắc được lựa chọn từ vùng nguyên liệu Hà Giang trước khi đưa vào chế biến."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Authenticity",
      "blocks": [
        { "type": "proof_point", "settings": { "icon": "🌿", "title": "Nguyên liệu tuyển chọn", "body": "Tam thất Bắc được lựa chọn từ vùng nguyên liệu Hà Giang trước khi đưa vào chế biến." } },
        { "type": "proof_point", "settings": { "icon": "📦", "title": "Đóng gói cẩn thận", "body": "Sản phẩm được đóng gói kín giúp giữ hương thơm và hạn chế ẩm trong quá trình bảo quản." } },
        { "type": "proof_point", "settings": { "icon": "🔬", "title": "Kiểm tra chất lượng", "body": "Nguyên liệu được kiểm tra trước khi đóng gói nhằm đảm bảo chất lượng ổn định." } }
      ]
    }
  ]
}
{% endschema %}
