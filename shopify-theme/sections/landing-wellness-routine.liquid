{% comment %}
  Landing Wellness Routine Section
{% endcomment %}
<section id="cach-dung" aria-label="Thói quen chăm sóc sức khỏe hàng ngày" class="bg-cream py-section-sm md:py-section-md" style="background-color: var(--cream); padding: 4rem 0;">
  <div class="max-w-wide mx-auto px-4 sm:px-8" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center;">
      <div class="aspect-square rounded-card overflow-hidden bg-pale-fern shadow-card" style="aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; background-color: var(--pale-fern);">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title | escape }}" class="w-full h-full object-cover" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        {% else %}
          {{ 'product-4' | placeholder_svg_tag: 'w-full h-full object-cover' }}
        {% endif %}
      </div>
      <div>
        <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage mb-3" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.75rem;">
          {{ section.settings.eyebrow | default: "Thói Quen Mỗi Ngày" }}
        </p>
        <h2 class="font-display text-display-md text-forest leading-[1.2] mb-6" style="color: var(--forest); font-size: 2.25rem; line-height: 1.2; margin-bottom: 1.5rem;">
          {{ section.settings.title | default: "Thói quen dưỡng sinh đơn giản nhất bạn có thể duy trì mỗi ngày" }}
        </h2>
        <div class="space-y-4 font-body text-body-lg text-stone-600 leading-relaxed mb-8" style="display: flex; flex-direction: column; gap: 1rem; color: var(--stone-600); font-size: 1.125rem; margin-bottom: 2rem;">
          <p style="margin: 0;">Hầu hết các phương pháp dưỡng sinh đều thất bại vì quá phức tạp, mất nhiều thời gian hoặc tốn kém.</p>
          <p style="margin: 0;">Tam Thất Quân Nguyễn được thiết kế theo một nguyên tắc: sản phẩm dược liệu tốt nhất phải dễ dàng hòa nhập vào nhịp sống của bạn.</p>
          <p class="font-semibold text-forest" style="color: var(--forest); font-weight: 600; margin: 0;">Một thìa bột. Nước ấm. Hai phút mỗi sáng.</p>
          <p style="margin: 0;">Chỉ đơn giản như vậy. Và vì chuẩn bị nhanh chóng, thói quen tốt này sẽ đồng hành cùng bạn mỗi ngày.</p>
        </div>
        <ul class="space-y-3 mb-8" style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: flex; flex-direction: column; gap: 0.75rem;">
          {% for block in section.blocks %}
            <li class="flex gap-3 items-start" style="display: flex; gap: 0.75rem; align-items: flex-start;" {{ block.shopify_attributes }}>
              <span style="color: var(--trust-green); font-weight: bold;">✓</span>
              <span class="font-body text-body-base text-stone-900" style="color: var(--stone-900); font-size: 1rem;">{{ block.settings.text }}</span>
            </li>
          {% endfor %}
        </ul>
        <p class="font-body text-body-sm italic text-stone-600" style="color: var(--stone-600); font-style: italic; font-size: 0.875rem; margin: 0;">Dược liệu cổ truyền — Phong cách sống hiện đại.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Wellness Routine",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Thói Quen Mỗi Ngày"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Thói quen dưỡng sinh đơn giản nhất bạn có thể duy trì mỗi ngày"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Routine Image"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet Text",
          "default": "Không cần đun sắc hay chế biến phức tạp"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing Wellness Routine",
      "blocks": [
        { "type": "bullet", "settings": { "text": "Không cần đun sắc hay chế biến phức tạp" } },
        { "type": "bullet", "settings": { "text": "Bột mịn hòa tan nhanh, mùi thơm tự nhiên" } },
        { "type": "bullet", "settings": { "text": "Bao bì khóa zip chống ẩm tiện mang đi làm hoặc du lịch" } },
        { "type": "bullet", "settings": { "text": "Hướng dẫn liều lượng rõ ràng trên từng bao bì" } },
        { "type": "bullet", "settings": { "text": "Hạn sử dụng 18 tháng bảo quản dễ dàng" } }
      ]
    }
  ]
}
{% endschema %}
