{% comment %}
  Landing Product Hero Section
{% endcomment %}
{% assign current_variant = product.selected_or_first_available_variant %}

<section
  id="san-pham"
  aria-label="Thông tin sản phẩm"
  class="bg-canvas py-section-sm md:py-section-md"
  style="background-color: var(--canvas); padding: 3rem 0;"
>
  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 xl:px-16" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">
    <div class="grid grid-cols-1 lg:grid-cols-[58%_42%] gap-8 lg:gap-14 items-start" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: start;">
      
      <!-- Product Media Gallery -->
      <div class="flex flex-col gap-3" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <div class="relative overflow-hidden rounded-card bg-parchment aspect-square" style="position: relative; overflow: hidden; border-radius: 12px; background-color: var(--parchment); aspect-ratio: 1 / 1; width: 100%;">
          {% if product.featured_media != blank %}
            <img
              src="{{ product.featured_media | image_url: width: 1000 }}"
              alt="{{ product.featured_media.alt | escape }}"
              width="1000"
              height="1000"
              class="w-full h-full object-contain"
              data-product-main-image
              style="width: 100%; height: 100%; object-fit: contain;"
              loading="eager"
            >
          {% elsif section.settings.image_1 != blank %}
            <img
              src="{{ section.settings.image_1 | image_url: width: 1000 }}"
              alt="{{ section.settings.title | escape }}"
              width="1000"
              height="1000"
              class="w-full h-full object-contain"
              data-product-main-image
              style="width: 100%; height: 100%; object-fit: contain;"
              loading="eager"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-contain' }}
          {% endif %}
        </div>

        <div class="grid grid-cols-4 gap-2" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
          {% if product.media.size > 0 %}
            {% for media in product.media limit: 4 %}
              <button
                type="button"
                data-product-thumb
                data-img-src="{{ media | image_url: width: 1000 }}"
                aria-label="Xem ảnh {{ forloop.index }}"
                class="aspect-square rounded-[8px] overflow-hidden bg-parchment border-2 transition-all duration-200 {% if forloop.first %}border-gold shadow-gold{% else %}border-stone-300{% endif %}"
                style="aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background-color: var(--parchment); border: 2px solid {% if forloop.first %}var(--gold){% else %}var(--stone-300){% endif %}; cursor: pointer; padding: 0;"
              >
                <img src="{{ media | image_url: width: 250 }}" alt="Thumbnail {{ forloop.index }}" width="250" height="250" class="w-full h-full object-contain" style="width: 100%; height: 100%; object-fit: contain;" loading="lazy">
              </button>
            {% endfor %}
          {% else %}
            {% for i in (1..4) %}
              {% capture img_key %}image_{{ i }}{% endcapture %}
              {% assign img_asset = section.settings[img_key] %}
              {% if img_asset != blank %}
                <button
                  type="button"
                  data-product-thumb
                  data-img-src="{{ img_asset | image_url: width: 1000 }}"
                  aria-label="Xem ảnh {{ i }}"
                  class="aspect-square rounded-[8px] overflow-hidden bg-parchment border-2 transition-all duration-200 {% if forloop.first %}border-gold shadow-gold{% else %}border-stone-300{% endif %}"
                  style="aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background-color: var(--parchment); border: 2px solid {% if forloop.first %}var(--gold){% else %}var(--stone-300){% endif %}; cursor: pointer; padding: 0;"
                >
                  <img src="{{ img_asset | image_url: width: 250 }}" alt="Thumbnail {{ i }}" width="250" height="250" class="w-full h-full object-contain" style="width: 100%; height: 100%; object-fit: contain;" loading="lazy">
                </button>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- Product Details & Purchase Form -->
      <div class="flex flex-col gap-5" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-sage" style="color: var(--sage); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">
          {{ section.settings.subheading | default: "TAM THẤT BẮC HÀ GIANG NGUYÊN CHẤT" }}
        </p>

        <h1 class="font-body text-2xl sm:text-3xl font-bold text-forest leading-relaxed tracking-tight" style="color: var(--forest); font-size: 1.75rem; font-weight: 700; margin: 0; line-height: 1.3;">
          {{ product.title | default: section.settings.title | default: "Tam thất nguyên chất 7 năm tuổi. Nghiền theo từng mẻ nhỏ để giữ trọn hương vị tự nhiên." }}
        </h1>

        <div class="flex items-center gap-3" style="display: flex; align-items: center; gap: 0.75rem;">
          <span class="text-gold text-body-lg tracking-tight" style="color: var(--gold);" aria-label="5 sao">★★★★★</span>
          <a href="#danh-gia" class="font-body text-body-sm text-stone-600 underline underline-offset-2 hover:text-forest" style="color: var(--stone-600); font-size: 0.875rem;">
            1.248 đánh giá thực
          </a>
          <span class="w-px h-4 bg-stone-300" style="width: 1px; height: 1rem; background-color: var(--stone-300);"></span>
          <span class="font-body text-body-sm text-trust-green font-semibold" style="color: var(--trust-green); font-size: 0.875rem; font-weight: 600;">Đã bán 5.000+ đơn</span>
        </div>

        <p class="font-body text-body-lg text-stone-600 leading-relaxed max-w-content" style="color: var(--stone-600); font-size: 1.125rem; line-height: 1.65; margin: 0;">
          {{ product.description | strip_html | truncatewords: 40 | default: "Tam thất là một dược liệu được sử dụng lâu đời trong y học cổ truyền. Chất lượng của củ phụ thuộc vào vùng trồng, thời gian sinh trưởng, quy trình sơ chế và cách bảo quản sau thu hoạch." }}
        </p>

        <!-- Variant Selection Cards -->
        {% if product != blank and product.variants.size > 1 %}
          <div>
            <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-stone-600 mb-2" style="color: var(--stone-600); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; margin-bottom: 0.5rem;">
              Chọn Gói:
            </p>
            <div class="flex flex-col sm:flex-row gap-2" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              {% for variant in product.variants %}
                <button
                  type="button"
                  data-variant-card
                  data-variant-id="{{ variant.id }}"
                  data-variant-price="{{ variant.price | money }}"
                  {% if variant.compare_at_price > variant.price %}
                    data-variant-compare-price="{{ variant.compare_at_price | money }}"
                    {% assign saving_pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
                    data-variant-savings="{{ saving_pct }}%"
                  {% endif %}
                  data-variant-stock="{{ variant.inventory_quantity | default: 23 }}"
                  aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                  class="relative flex-1 flex flex-col items-center justify-center text-center px-3 pt-5 pb-3.5 rounded-card border-2 transition-all duration-200 {% if variant.id == current_variant.id %}border-forest bg-pale-fern{% else %}border-stone-300 bg-canvas{% endif %}"
                  style="flex: 1; padding: 1rem; border-radius: 12px; border: 2px solid {% if variant.id == current_variant.id %}var(--forest){% else %}var(--stone-300){% endif %}; background-color: {% if variant.id == current_variant.id %}var(--pale-fern){% else %}var(--canvas){% endif %}; cursor: pointer; text-align: center;"
                >
                  <span class="block font-body text-body-sm font-semibold text-stone-900 text-center leading-tight" style="color: var(--stone-900); font-weight: 600;">{{ variant.title }}</span>
                  <span class="block font-mono text-body-sm text-forest font-medium mt-1 text-center" style="color: var(--forest); font-family: monospace;">{{ variant.price | money }}</span>
                </button>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <!-- Static Fallback Variant Display -->
          <div>
            <p class="font-body text-label-lg font-semibold uppercase tracking-widest text-stone-600 mb-2" style="color: var(--stone-600); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase;">
              Chọn Gói:
            </p>
            <div class="flex flex-col sm:flex-row gap-2" style="display: flex; gap: 0.5rem;">
              <div class="flex-1 text-center px-3 pt-4 pb-3 rounded-card border-2 border-forest bg-pale-fern" style="flex: 1; padding: 0.75rem; border-radius: 12px; border: 2px solid var(--forest); background-color: var(--pale-fern);">
                <span class="block font-body text-body-sm font-semibold text-stone-900">Gói Dùng Thử 100g</span>
                <span class="block font-mono text-body-sm text-forest font-medium mt-1">299.000 ₫</span>
              </div>
              <div class="flex-1 text-center px-3 pt-4 pb-3 rounded-card border-2 border-stone-300 bg-canvas" style="flex: 1; padding: 0.75rem; border-radius: 12px; border: 2px solid var(--stone-300); background-color: var(--canvas);">
                <span class="block font-body text-body-sm font-semibold text-stone-900">Gói Gia Đình 300g</span>
                <span class="block font-mono text-body-sm text-forest font-medium mt-1">750.000 ₫</span>
              </div>
              <div class="flex-1 text-center px-3 pt-4 pb-3 rounded-card border-2 border-stone-300 bg-canvas" style="flex: 1; padding: 0.75rem; border-radius: 12px; border: 2px solid var(--stone-300); background-color: var(--canvas);">
                <span class="block font-body text-body-sm font-semibold text-stone-900">Gói Tích Lũy 500g</span>
                <span class="block font-mono text-body-sm text-forest font-medium mt-1">1.150.000 ₫</span>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- Pricing Display -->
        <div class="flex items-baseline gap-3 flex-wrap" style="display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;">
          <span class="font-mono text-price-xl font-bold text-forest" data-product-price-display style="font-family: monospace; font-size: 2.25rem; font-weight: 700; color: var(--forest);">
            {% if current_variant %}
              {{ current_variant.price | money }}
            {% else %}
              299.000 ₫
            {% endif %}
          </span>
          <span class="font-body text-body-base text-stone-600 line-through" data-product-compare-price-display style="color: var(--stone-600); text-decoration: line-through;">
            {% if current_variant.compare_at_price > current_variant.price %}
              {{ current_variant.compare_at_price | money }}
            {% else %}
              450.000 ₫
            {% endif %}
          </span>
          <span class="bg-amber/30 text-stone-900 font-body text-label-lg font-bold uppercase tracking-wide px-2.5 py-1 rounded-badge" data-product-savings-display style="background-color: rgba(232, 183, 90, 0.3); color: var(--stone-900); font-weight: 700; font-size: 0.75rem; padding: 0.25rem 0.625rem; border-radius: 999px;">
            Tiết kiệm 33%
          </span>
        </div>

        <!-- Stock Scarcity Warning -->
        <div class="flex items-center gap-2" style="display: flex; align-items: center; gap: 0.5rem;">
          <span class="w-2 h-2 rounded-full bg-alert-amber animate-pulse inline-block" style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--alert-amber); display: inline-block;"></span>
          <p class="font-body text-body-sm text-alert-amber font-semibold" data-product-stock-display style="color: var(--alert-amber); font-weight: 600; margin: 0; font-size: 0.875rem;">
            Chỉ còn 23 hộp trong kho — đặt ngay để đảm bảo hàng
          </p>
        </div>

        <!-- Standard Shopify Form Engine Binding -->
        {% form 'product', product, class: 'flex flex-col gap-3' %}
          <input type="hidden" name="id" data-product-variant-id value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">

          <div class="flex flex-col sm:flex-row gap-3" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button
              type="submit"
              name="add"
              class="relative flex-1 bg-forest text-amber font-body font-bold text-body-base uppercase tracking-widest py-4 px-6 rounded-btn hover:bg-jade transition-colors duration-200 focus:outline-none"
              style="flex: 1; min-width: 240px; background-color: var(--forest); color: var(--amber); font-weight: 700; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; padding: 1rem 1.5rem; border-radius: 8px; border: none; cursor: pointer; text-align: center;"
              aria-label="Thêm vào giỏ hàng và đặt mua ngay"
            >
              🛒 Đặt Mua Ngay — Giao Trong 2 Ngày
            </button>

            <a
              href="#cach-dung"
              class="flex-shrink-0 border-2 border-forest text-forest font-body font-semibold text-body-sm uppercase tracking-widest py-4 px-5 rounded-btn text-center hover:bg-pale-fern transition-colors duration-200"
              style="border: 2px solid var(--forest); color: var(--forest); font-weight: 600; font-size: 0.875rem; text-transform: uppercase; padding: 1rem 1.25rem; border-radius: 8px; text-decoration: none; display: inline-block; text-align: center;"
            >
              Xem Cách Dùng ↓
            </a>
          </div>
        {% endform %}

        <p class="font-body text-body-sm text-stone-600" style="color: var(--stone-600); font-size: 0.875rem; margin: 0;">
          🚚 Đặt trước 15:00 → Giao ngay hôm nay
        </p>

        <!-- Trust Badges -->
        <div class="flex flex-wrap gap-2 pt-1" style="display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 0.25rem;">
          <span class="bg-pale-fern text-forest font-body text-label-sm font-semibold uppercase tracking-wide px-3 py-1.5 rounded-badge border border-sage/30" style="background-color: var(--pale-fern); color: var(--forest); font-size: 0.6875rem; font-weight: 600; padding: 0.375rem 0.75rem; border-radius: 999px;">
            ✓ ĐỔI TRẢ TRONG 30 NGÀY THEO CHÍNH SÁCH
          </span>
          <span class="bg-pale-fern text-forest font-body text-label-sm font-semibold uppercase tracking-wide px-3 py-1.5 rounded-badge border border-sage/30" style="background-color: var(--pale-fern); color: var(--forest); font-size: 0.6875rem; font-weight: 600; padding: 0.375rem 0.75rem; border-radius: 999px;">
            ✓ TUYỂN CHỌN TỪ VÙNG NGUYÊN LIỆU HÀ GIANG
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

{% render 'landing-sticky-cart-bar', product: product %}

{% schema %}
{
  "name": "Landing Product Hero",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "TAM THẤT BẮC HÀ GIANG NGUYÊN CHẤT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title Fallback",
      "default": "Tam thất nguyên chất 7 năm tuổi. Nghiền theo từng mẻ nhỏ để giữ trọn hương vị tự nhiên."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Fallback Gallery Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Fallback Gallery Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Fallback Gallery Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Fallback Gallery Image 4"
    }
  ],
  "presets": [
    {
      "name": "Landing Product Hero"
    }
  ]
}
{% endschema %}
